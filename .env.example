# Required in production (openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the app (used for auth callbacks / trusted origin)
BETTER_AUTH_URL=http://localhost:3000
# SQLite file location. On Render, point at the persistent disk, e.g. /var/data/lantern.db
DATABASE_PATH=./data/lantern.db
